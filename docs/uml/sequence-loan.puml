@startuml
title Sequentiediagram - Boek uitlenen

actor Beheerder
participant "LoanController" as Controller
participant "LoanService" as Service
participant "BookCopyRepository" as BookCopyRepo
participant "CustomerRepository" as CustomerRepo
participant "LoanRepository" as LoanRepo
participant "LoanMapper" as Mapper

Beheerder -> Controller : POST /api/loans\n(LoanRequest)
activate Controller

Controller -> Service : createLoan(LoanRequest request)
activate Service

Service -> BookCopyRepo : findById(request.bookCopyId())
activate BookCopyRepo
BookCopyRepo --> Service : Optional<BookCopy>
deactivate BookCopyRepo

alt BookCopy niet gevonden
    Service --> Controller : throw RecordNotFoundException
    Controller --> Beheerder : 404 Not Found
else BookCopy status != AVAILABLE
    Service --> Controller : throw BadRequestException
    Controller --> Beheerder : 400 Bad Request
else BookCopy beschikbaar
    Service -> CustomerRepo : findById(request.customerId())
    activate CustomerRepo
    CustomerRepo --> Service : Optional<Customer>
    deactivate CustomerRepo

    alt Customer niet gevonden
        Service --> Controller : throw RecordNotFoundException
        Controller --> Beheerder : 404 Not Found
    else Customer gevonden
        Service -> Service : bookCopy.setStatus(LOANED)
        Service -> BookCopyRepo : save(bookCopy)
        activate BookCopyRepo
        BookCopyRepo --> Service : BookCopy
        deactivate BookCopyRepo

        Service -> Mapper : toEntity(request, customer, bookCopy)
        activate Mapper
        Mapper --> Service : Loan
        deactivate Mapper

        Service -> LoanRepo : save(loan)
        activate LoanRepo
        LoanRepo --> Service : Loan saved
        deactivate LoanRepo

        Service -> Mapper : toResponse(saved)
        activate Mapper
        Mapper --> Service : LoanResponse
        deactivate Mapper

        Service --> Controller : LoanResponse
        Controller --> Beheerder : 201 Created\n(LoanResponse)
    end
end

deactivate Service
deactivate Controller

@enduml