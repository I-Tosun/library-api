@startuml

title Sequentiediagram - Boek retourneren

actor Beheerder
participant "LoanController" as Controller
participant "LoanService" as Service
participant "LoanRepository" as LoanRepo
participant "BookCopyRepository" as BookCopyRepo
participant "LoanMapper" as Mapper

Beheerder -> Controller : PUT /api/loans/{id}/return
activate Controller

Controller -> Service : returnLoan(id)
activate Service

Service -> LoanRepo : findById(id)
activate LoanRepo
LoanRepo --> Service : Optional<Loan>
deactivate LoanRepo

alt Loan niet gevonden
    Service --> Controller : throw RecordNotFoundException
    Controller --> Beheerder : 404 Not Found
else Loan al geretourneerd (returnDate != null)
    Service --> Controller : throw BadRequestException
    Controller --> Beheerder : 400 Bad Request
else Loan actief (returnDate == null)
    Service -> Service : loan.setReturnDate(LocalDate.now())
    Service -> Service : bookCopy = loan.getBookCopy()
    Service -> Service : bookCopy.setStatus(AVAILABLE)

    Service -> BookCopyRepo : save(bookCopy)
    activate BookCopyRepo
    BookCopyRepo --> Service : BookCopy
    deactivate BookCopyRepo

    Service -> LoanRepo : save(loan)
    activate LoanRepo
    LoanRepo --> Service : Loan saved
    deactivate LoanRepo

    Service -> Mapper : toResponse(saved)
    activate Mapper
    Mapper --> Service : LoanResponse
    deactivate Mapper

    Service --> Controller : LoanResponse
    Controller --> Beheerder : 200 OK\n(LoanResponse)
end

deactivate Service
deactivate Controller

@enduml